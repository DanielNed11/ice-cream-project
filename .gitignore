# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.idea

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal reference/skill library, not project source
/front end tools/

# raw animation source videos -- only used locally by `npm run prep:frames`
# to generate public/sequences/; never served to visitors. Keep these on
# disk as the source-of-truth for re-extracting frames, but don't bloat the
# repo with them.
/*-animation-high.webp
/*-animation-final.webp
